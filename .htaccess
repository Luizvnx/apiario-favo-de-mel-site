# Apiário Favo de Mel - Configuração Apache Hostinger
DirectoryIndex index.html
Options -Indexes
RewriteEngine On
RewriteBase /

# 1. Redirecionamento Canônico 301 de URLs terminadas em .html para URLs limpas (sem .html)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/index\.html
RewriteRule ^ /%1 [R=301,L]

# 2. Permite acesso direto a arquivos estáticos existentes (exceto .html que já foram tratados)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !\.(html|htm)$ [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Rotas amigáveis explícitas de produtos, serviços e catálogo
RewriteRule ^catalogo/?$ catalogo.html [L]
RewriteRule ^pedido/?$ pedido.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^mel-com-favo/?$ mel-com-favo.html [L]
RewriteRule ^propolis-vermelha/?$ propolis-vermelha.html [L]
RewriteRule ^propolis-verde/?$ propolis-verde.html [L]
RewriteRule ^mel-de-urucu/?$ mel-de-urucu.html [L]
RewriteRule ^polen-apicola/?$ polen-apicola.html [L]
RewriteRule ^mel-silvestre/?$ mel-silvestre.html [L]
RewriteRule ^kit-presente/?$ kit-presente.html [L]
RewriteRule ^resgate-de-abelhas/?$ resgate-de-abelhas.html [L]
RewriteRule ^consultoria-apicola/?$ consultoria-apicola.html [L]

# 4. Fallback genérico para qualquer página .html sem extensão
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 5. Rota raiz abre index.html
RewriteRule ^$ index.html [L]

# Compressão Gzip para carregamento instantâneo
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de ativos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>